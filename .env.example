# Google Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/auth/google/callback

# Google Gemini API Key
GEMINI_API_KEY=

# Application & Auth Settings
DATABASE_URL=
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
MODEL_API_URL=
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Production deployment
# Vercel: set NEXT_PUBLIC_API_URL and MODEL_API_URL to the public Render API URL.
# Render: set FRONTEND_URL to the public Vercel URL and/or provide comma-separated CORS_ORIGINS.
FRONTEND_URL=
CORS_ORIGINS=
